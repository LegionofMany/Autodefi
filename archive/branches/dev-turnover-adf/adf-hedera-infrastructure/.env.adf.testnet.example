# ADF Hedera Testnet Example
# Copy to .env.adf.testnet locally. Never commit the copied file with live values.

NODE_ENV=development
ADF_APP_ENV=testnet

HEDERA_NETWORK=testnet
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296

# Secrets: keep local only
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=
HEDERA_TREASURY_ACCOUNT_ID=
HEDERA_TREASURY_PRIVATE_KEY=

# Populated after portal token creation
ADF_TOKEN_ID=
ADF_TOKEN_ADDRESS=
ADF_TOKEN_SYMBOL=ADF
ADF_TOKEN_NAME="AutoDeFi Token"
ADF_TOKEN_DECIMALS=8
ADF_TOKEN_DISPLAY_SUPPLY=5000000000
ADF_TOKEN_RAW_SUPPLY=500000000000000000

# Public frontend values after token exists
NEXT_PUBLIC_HEDERA_NETWORK=testnet
NEXT_PUBLIC_HEDERA_CHAIN_ID=296
NEXT_PUBLIC_HEDERA_RPC_URL=https://testnet.hashio.io/api
NEXT_PUBLIC_ADF_TOKEN_ID=
NEXT_PUBLIC_ADF_TOKEN_ADDRESS=
