{
  "name": "autodefi-v1",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:validate": "tsx scripts/validate-prisma.ts",
    "db:seed": "tsx prisma/seed.ts",
    "seed:defaults": "tsx scripts/seed-defaults.ts",
    "seed:v1-demo": "tsx scripts/seed-v1-demo.ts",
    "verify:v1-demo": "tsx scripts/verify-v1-demo.ts",
    "reset:v1-demo": "tsx scripts/reset-v1-demo.ts",
    "run:v1-flow": "tsx scripts/run-v1-flow.ts",
    "rerun:v1-flow": "tsx scripts/reset-and-run-v1-flow.ts",
    "summary:v1-flow": "tsx scripts/v1-flow-summary.ts",
    "complete:v1": "tsx scripts/complete-v1.ts",
    "audit:v1-ready": "tsx scripts/audit-v1-ready.ts",
    "audit:v1-structure": "tsx scripts/audit-v1-repo-structure.ts",
    "audit:v1-env": "tsx scripts/audit-v1-env.ts",
    "security:check": "tsx scripts/security-check.ts",
    "setup:v1-local": "tsx scripts/setup-v1-local.ts"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3"
  }
}
