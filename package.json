{
  "name": "autodefi-frontend-v1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint:types": "tsc -b --pretty",
    "audit:v1-docs": "tsx scripts/audit-v1-docs.ts",
    "audit:ai-underwriting-svg-lock": "tsx scripts/audit-ai-underwriting-svg-lock.ts",
    "audit:consolidated-graphics": "tsx scripts/audit-consolidated-graphics.ts",
    "audit:dashboard-consolidation": "node --import tsx scripts/audit-dashboard-consolidation.ts",
    "verify:dashboard-render": "node --import tsx scripts/verify-dashboard-render.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "vite": "8.2.0",
    "typescript": "5.9.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tsx": "4.23.1"
  }
}
